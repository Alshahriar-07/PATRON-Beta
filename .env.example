# PATRON environment template.
#
# PATRON needs NO credentials: it reads public Binance market data and writes
# only local files. There is no order execution, no authenticated endpoint, and
# this release reads no environment variables for configuration — endpoints and
# paths live in config/*.yaml and CLI flags.
#
# Every value below is a dummy placeholder, kept so that tooling which expects a
# `.env.example` has one. Do not put real credentials here. `.env` is
# git-ignored; never commit it.

# Public market-data endpoints (documentation only — set these in config/model_config.yaml).
PATRON_BINANCE_BASE_URL=https://data.binance.vision
PATRON_BINANCE_REST_URL=https://api.binance.com

# Unused placeholders. This release never authenticates to an exchange.
BINANCE_API_KEY=replace-me-unused
BINANCE_API_SECRET=replace-me-unused
