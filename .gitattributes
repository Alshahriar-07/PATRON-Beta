# Normalise line endings on checkout; keep scripts usable on their native platform.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf

# Binary artifacts
*.pt       binary
*.parquet  binary
*.db       binary
*.png      binary
*.zip      binary
*.tar.gz   binary
*.whl      binary

# Generated files: keep them out of language statistics
dist/**            linguist-generated=true
reports/live/**    linguist-generated=true
reports/predictions/** linguist-generated=true
data/**            linguist-vendored
